# Deploy the public site only. Everything at the repository root is excluded
# and the public pages are re-included explicitly, so working files, source
# projects, previews and media cannot become public routes by accident.
/*

!assets/
!api/
# The collection modules the functions import. Tests live in test/, which
# is deliberately NOT re-included: anything under a deployed directory is
# served as a file, and test sources are not public documents.
!lib/
!vercel.json
!robots.txt
!favicon.ico
!sitemap.xml
!404.html

!index.html
!discipline.html
!bench.html
!readings.html
!bureau.html
!accessibility.html
!privacy.html
!terms.html
!contact.html
