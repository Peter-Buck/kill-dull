{
  "alias": [
    "kill-dull-git-build-homepage-sept-7-peter-buck-s-projects.vercel.app"
  ],
  "redirects": [
    { "source": "/go-deeper", "destination": "/discipline", "permanent": false },
    { "source": "/office", "destination": "/bureau", "permanent": true },
    { "source": "/office.html", "destination": "/bureau", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/discipline", "destination": "/discipline.html" },
    { "source": "/bench", "destination": "/bench.html" },
    { "source": "/pitch", "destination": "/pitch.html" },
    { "source": "/readings", "destination": "/readings.html" },
    { "source": "/bureau", "destination": "/bureau.html" },
    { "source": "/accessibility", "destination": "/accessibility.html" },
    { "source": "/language", "destination": "/language.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
      ]
    }
  ]
}
