{
  "functions": {
    "api/ask.js": {
      "maxDuration": 60,
      "includeFiles": "{index,why,how,offer,outcome,bureau,assessment,contact,privacy,terms,accessibility}.html"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "kill-dull.vercel.app"
        }
      ],
      "destination": "https://killdull.com/:path",
      "permanent": false
    },
    {
      "source": "/go-deeper",
      "destination": "/how",
      "permanent": false
    },
    {
      "source": "/office",
      "destination": "/bureau",
      "permanent": true
    },
    {
      "source": "/office.html",
      "destination": "/bureau",
      "permanent": true
    },
    {
      "source": "/storm.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/heather-preview.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/language",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/language.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pitch",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pitch.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/discipline",
      "destination": "/how",
      "permanent": true
    },
    {
      "source": "/discipline.html",
      "destination": "/how",
      "permanent": true
    },
    {
      "source": "/how.html",
      "destination": "/how",
      "permanent": true
    },
    {
      "source": "/bench",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/bench.html",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/offer.html",
      "destination": "/offer",
      "permanent": true
    },
    {
      "source": "/readings",
      "destination": "/outcome",
      "permanent": true
    },
    {
      "source": "/readings.html",
      "destination": "/outcome",
      "permanent": true
    },
    {
      "source": "/outcome.html",
      "destination": "/outcome",
      "permanent": true
    },
    {
      "source": "/bureau.html",
      "destination": "/bureau",
      "permanent": true
    },
    {
      "source": "/accessibility.html",
      "destination": "/accessibility",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/assessment.html",
      "destination": "/assessment",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/why",
      "destination": "/why.html"
    },
    {
      "source": "/how",
      "destination": "/how.html"
    },
    {
      "source": "/offer",
